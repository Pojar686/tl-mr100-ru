{
  "manifest_version": 3,
  "name": "TL-MR100 — русский интерфейс",
  "short_name": "TL-MR100 RU",
  "version": "1.0.1",
  "description": "Русский перевод веб-интерфейса роутера TP-Link TL-MR100 v3 (прошивка 1.7.0 и новее).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.1.1/*",
        "https://192.168.1.1/*",
        "http://tplinkmodem.net/*",
        "https://tplinkmodem.net/*"
      ],
      "js": [
        "page-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}